generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum HabitKind {
  GOOD
  BAD
}

enum HabitFrequency {
  DAILY
  WEEKLY
}

enum HabitImpact {
  XP
  LIFE
}

model Habit {
  id          String          @id @default(uuid())
  userId      Int
  name        String
  description String?

  kind        HabitKind       // GOOD / BAD
  frequency   HabitFrequency  // DAILY / WEEKLY
  impact      HabitImpact     // XP / LIFE

  value       Int             // +XP o -vida
  isActive    Boolean         @default(true)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
}