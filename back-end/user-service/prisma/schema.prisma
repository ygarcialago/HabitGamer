generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  nameApp  String @unique @db.VarChar(100)
  email    String @unique @db.VarChar(150)
  password String @db.VarChar(255)
}
