generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlayerType {
  KNIGHT
  ELF
  DWARF
  MAGICIAN
  ROGUE
  PALADIN
  RANGER
  CLERIC
}

enum Gender {
  MALE
  FEMALE
}

model Player {
  id        String      @id @default(uuid())
  id_user   String      @unique

  xp        Int         @default(0)
  level     Int         @default(1)
  life      Int         @default(100)
  isDead    Boolean     @default(false)

  title     String?
  type   PlayerType @default(KNIGHT)
  gender Gender     @default(MALE)

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@map("player")
}
